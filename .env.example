ALPACA_PAPER_API_KEY=your-paper-key-here # Alpaca paper trading API key from the Alpaca dashboard
ALPACA_PAPER_API_SECRET=your-paper-secret-here # Alpaca paper trading API secret from the Alpaca dashboard
ALPACA_PAPER_ACCOUNT_ID=your-paper-account-id-here # Optional Alpaca paper account identifier from the dashboard
ALPACA_LIVE_API_KEY= # Leave empty until Gate 4 operator sign-off enables live trading
ALPACA_LIVE_API_SECRET= # Leave empty until Gate 4 operator sign-off enables live trading
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here # Telegram bot token from BotFather for the primary operator channel
TELEGRAM_ALLOWED_CHAT_IDS=123456789 # Comma-separated Telegram chat IDs allowed to control or receive alerts
CLICKUP_API_TOKEN=your-clickup-api-token-here # ClickUp API token for non-urgent reporting integrations
CLICKUP_WORKSPACE_ID=your-clickup-workspace-id-here # ClickUp workspace identifier used for project reporting
CLICKUP_LIST_ID=your-clickup-list-id-here # ClickUp list identifier used for non-urgent status updates
SMTP_HOST=smtp.example.com # SMTP server hostname for emergency alert delivery
SMTP_PORT=587 # SMTP server port for emergency alert delivery
SMTP_USERNAME=your-smtp-username-here # SMTP username for the emergency email account
SMTP_PASSWORD=your-smtp-password-here # SMTP password or app password for the emergency email account
SMTP_FROM_ADDRESS=bot@example.com # From address used for emergency alerts
SMTP_TO_ADDRESS=operator@example.com # Destination inbox for emergency alerts
TRADINGX_MANUAL_KILL_SWITCH=false # Emergency local halt flag; keep false during normal paper operation
