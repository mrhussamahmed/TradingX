ALPACA_PAPER_API_KEY=your-paper-key-here # Alpaca paper trading API key from the Alpaca dashboard
ALPACA_PAPER_API_SECRET=your-paper-secret-here # Alpaca paper trading API secret from the Alpaca dashboard
ALPACA_PAPER_ACCOUNT_ID=your-paper-account-id-here # Optional Alpaca paper account identifier from the dashboard
ALPACA_LIVE_API_KEY= # Leave empty until Gate 4 operator sign-off enables live trading
ALPACA_LIVE_API_SECRET= # Leave empty until Gate 4 operator sign-off enables live trading
TRADINGX_ARTIFACT_ROOT=artifacts # Root directory for persisted paper-trading evidence
TRADINGX_METRICS_NAMESPACE=tradingx # Prometheus namespace prefix for local metrics
TRADINGX_ENFORCE_REGULAR_HOURS=true # Keep true for Stage 1; the service will stand down outside regular hours
TRADINGX_COMMAND_TIMEOUT_SECONDS=30 # Broker polling timeout for single trading actions
TRADINGX_MANUAL_KILL_SWITCH=false # Emergency local halt flag; keep false during normal paper operation
TRADINGX_SERVICE_INTERVAL_SECONDS=300 # Cadence for the recurring paper service in seconds
TRADINGX_SCHEDULER_POLL_SECONDS=60 # Poll cadence for the recurring market-day scheduler when waiting for the next session
TRADINGX_LOG_MAX_BYTES=104857600 # Structured runtime log rotation threshold per component file
TRADINGX_LOG_RETENTION_FILES=30 # Structured runtime log rotation retention count per component file
TRADINGX_SYMBOL_UNIVERSE=SPY,QQQ,IWM # Comma-separated bounded universe scanned by the paper service
TRADINGX_WEB_HOST=127.0.0.1 # Local-only bind host for the FastAPI + React control surface
TRADINGX_WEB_PORT=8765 # Local port for the control website
TRADINGX_WEB_WRITE_MODE_ENABLED=false # Keep false unless you explicitly want local write controls enabled
TRADINGX_TELEGRAM_BOT_TOKEN= # Optional Telegram BotFather token for operator alerts
TRADINGX_TELEGRAM_CHAT_ID= # Optional Telegram destination chat id for operator alerts
TRADINGX_SMTP_HOST= # Optional SMTP host for operator email alerts
TRADINGX_SMTP_PORT=587 # Optional SMTP port for operator email alerts
TRADINGX_SMTP_USERNAME= # Optional SMTP username for operator email alerts
TRADINGX_SMTP_PASSWORD= # Optional SMTP password or app password for operator email alerts
TRADINGX_SMTP_FROM_EMAIL= # Optional From address used for operator email alerts
TRADINGX_SMTP_TO_EMAIL= # Optional destination inbox used for operator email alerts
TRADINGX_SMTP_USE_STARTTLS=true # Enable STARTTLS for SMTP if your provider requires it
