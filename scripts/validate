#!/usr/bin/env bash
set -euo pipefail

echo "==> Validating artifact index"
python3 scripts/check_index.py

echo "==> Ruff"
uv run ruff check src tests scripts

echo "==> Black"
uv run black --check src tests scripts

echo "==> mypy"
uv run mypy --strict src

echo "==> pytest (unit + integration + coverage)"
uv run pytest \
  tests/unit \
  tests/contract \
  tests/integration \
  --cov=tradingx \
  --cov-report=term-missing \
  --cov-fail-under=80

echo "==> Smoke test gate"
if uv run python -c "from dotenv import dotenv_values; env = dotenv_values('.env'); values = [env.get('ALPACA_PAPER_API_KEY', ''), env.get('ALPACA_PAPER_API_SECRET', '')]; import sys; sys.exit(0 if all(value and 'your-' not in value.lower() and 'placeholder' not in value.lower() for value in values) else 1)"; then
  uv run pytest tests/smoke -rs
else
  echo 'Skipping smoke tests: .env does not contain real Alpaca paper credentials yet.'
fi
