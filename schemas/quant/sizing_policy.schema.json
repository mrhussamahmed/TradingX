{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Sizing Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "policy_id",
    "strategy_id",
    "sizing_method",
    "target_volatility",
    "position_cap",
    "sleeve_cap",
    "gross_exposure_cap",
    "net_exposure_cap",
    "leverage_cap",
    "order_cap",
    "participation_cap",
    "drawdown_budget",
    "cost_model_ref",
    "capacity_curve_ref",
    "kelly_disabled",
    "kelly_gate_complete",
    "max_kelly_multiplier",
    "freeze_at_utc",
    "sizing_policy_hash",
    "approved_at_utc",
    "approver",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "sizing_policy"},
    "policy_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "sizing_method": {"type": "string"},
    "target_volatility": {"type": "string"},
    "position_cap": {"type": "string"},
    "sleeve_cap": {"type": "string"},
    "gross_exposure_cap": {"type": "string"},
    "net_exposure_cap": {"type": "string"},
    "leverage_cap": {"type": "string"},
    "order_cap": {"type": "string"},
    "participation_cap": {"type": "string"},
    "drawdown_budget": {"type": "string"},
    "cost_model_ref": {"type": "string"},
    "capacity_curve_ref": {"type": "string"},
    "kelly_disabled": {"type": "boolean"},
    "kelly_gate_complete": {"type": "boolean"},
    "max_kelly_multiplier": {"type": "string"},
    "freeze_at_utc": {"type": "string", "format": "utc-datetime"},
    "sizing_policy_hash": {"type": "string"},
    "approved_at_utc": {"type": "string", "format": "utc-datetime"},
    "approver": {"type": "string"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
