{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Investment Mandate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "mandate_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "account_type",
    "base_currency",
    "starting_capital",
    "target_scale",
    "allowed_instruments",
    "forbidden_instruments",
    "leverage_policy",
    "shorting_policy",
    "liquidity_policy",
    "tax_modeled",
    "tax_account_type",
    "pre_tax_or_after_tax",
    "taxable_or_tax_exempt_status",
    "tax_assumptions",
    "fx_policy",
    "margin_policy",
    "max_drawdown_limit",
    "cdar_limit",
    "cdar_horizon_days",
    "daily_loss_limit",
    "weekly_loss_limit",
    "liquidity_runway_days",
    "margin_financing_stress",
    "ruin_threshold",
    "forced_de_risking_rule",
    "external_cash_flow_policy"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "investment_mandate"},
    "strategy_id": {"type": "string"},
    "mandate_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "account_type": {"type": "string"},
    "base_currency": {"type": "string"},
    "starting_capital": {"type": "string", "format": "decimal-string"},
    "target_scale": {"type": "string", "format": "decimal-string"},
    "allowed_instruments": {"type": "array", "items": {"type": "string"}},
    "forbidden_instruments": {"type": "array", "items": {"type": "string"}},
    "leverage_policy": {"type": "string"},
    "shorting_policy": {"type": "string"},
    "liquidity_policy": {"type": "string"},
    "tax_modeled": {"type": "boolean"},
    "tax_account_type": {"type": "string"},
    "pre_tax_or_after_tax": {"type": "string"},
    "taxable_or_tax_exempt_status": {"type": "string"},
    "tax_assumptions": {"type": "string"},
    "fx_policy": {"type": "string"},
    "margin_policy": {"type": "string"},
    "max_drawdown_limit": {"type": "string", "format": "decimal-string"},
    "cdar_limit": {"type": "string", "format": "decimal-string"},
    "cdar_horizon_days": {"type": "integer"},
    "daily_loss_limit": {"type": "string", "format": "decimal-string"},
    "weekly_loss_limit": {"type": "string", "format": "decimal-string"},
    "liquidity_runway_days": {"type": "integer"},
    "margin_financing_stress": {"type": "string"},
    "ruin_threshold": {"type": "string", "format": "decimal-string"},
    "forced_de_risking_rule": {"type": "string"},
    "external_cash_flow_policy": {"type": "string"}
  }
}
