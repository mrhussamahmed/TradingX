{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Capital Allocation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "allocation_policy_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "initial_allocation",
    "max_strategy_allocation",
    "max_sleeve_allocation",
    "reserve_policy",
    "reinvestment_policy",
    "scale_up_rule",
    "scale_down_rule",
    "cooldown_days",
    "repeated_look_control",
    "strategy_churn_control"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "capital_allocation_policy"},
    "strategy_id": {"type": "string"},
    "allocation_policy_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "initial_allocation": {"type": "string", "format": "decimal-string"},
    "max_strategy_allocation": {"type": "string", "format": "decimal-string"},
    "max_sleeve_allocation": {"type": "string", "format": "decimal-string"},
    "reserve_policy": {"type": "string"},
    "reinvestment_policy": {"type": "string"},
    "scale_up_rule": {"type": "string"},
    "scale_down_rule": {"type": "string"},
    "cooldown_days": {"type": "integer"},
    "repeated_look_control": {"type": "string"},
    "strategy_churn_control": {"type": "string"}
  }
}
