{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Jurisdiction Account Use Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "jurisdiction",
    "account_use",
    "owner_operator_role",
    "classification",
    "broker_permission_status",
    "margin_permission_status",
    "instrument_eligibility_status",
    "short_eligibility_status",
    "fiduciary_duty_status",
    "client_suitability_status",
    "marketing_status",
    "custody_status",
    "record_retention_status",
    "account_restriction_status",
    "compliance_review_refs",
    "live_trading_ceiling"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "jurisdiction_account_use_manifest"},
    "strategy_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "jurisdiction": {"type": "string"},
    "account_use": {"type": "string"},
    "owner_operator_role": {"type": "string"},
    "classification": {"type": "string"},
    "broker_permission_status": {"type": "string"},
    "margin_permission_status": {"type": "string"},
    "instrument_eligibility_status": {"type": "string"},
    "short_eligibility_status": {"type": "string"},
    "fiduciary_duty_status": {"type": "string"},
    "client_suitability_status": {"type": "string"},
    "marketing_status": {"type": "string"},
    "custody_status": {"type": "string"},
    "record_retention_status": {"type": "string"},
    "account_restriction_status": {"type": "string"},
    "compliance_review_refs": {"type": "array", "items": {"type": "string"}},
    "live_trading_ceiling": {"type": "string"}
  }
}
