{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Benchmark Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "benchmark_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "ex_ante",
    "benchmark_refs",
    "cash_benchmark",
    "investable_market_benchmark",
    "allocation_alternative",
    "no_trade_baseline",
    "simple_etf_alternative",
    "exclusions",
    "compatibility"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "benchmark_policy"},
    "strategy_id": {"type": "string"},
    "benchmark_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "ex_ante": {"type": "boolean"},
    "benchmark_refs": {"type": "array", "items": {"type": "string"}},
    "cash_benchmark": {"type": "string"},
    "investable_market_benchmark": {"type": "string"},
    "allocation_alternative": {"type": "string"},
    "no_trade_baseline": {"type": "string"},
    "simple_etf_alternative": {"type": "string"},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "compatibility": {"type": "string"}
  }
}
