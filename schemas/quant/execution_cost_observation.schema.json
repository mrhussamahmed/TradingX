{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Execution Cost Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observation_id",
    "intent_id",
    "order_id",
    "execution_id",
    "symbol",
    "side",
    "order_type",
    "time_in_force",
    "venue",
    "broker_route",
    "decision_at_utc",
    "submit_at_utc",
    "ack_at_utc",
    "fill_at_utc",
    "arrival_timestamp_policy",
    "arrival_mid",
    "fill_price",
    "requested_qty",
    "filled_qty",
    "unfilled_qty",
    "partial_fill",
    "non_fill_reason",
    "signed_slippage_bps",
    "half_spread_bps",
    "queue_adverse_selection_bps",
    "halt_state",
    "open_close_state",
    "rate_limit_state",
    "notional",
    "interval_volume",
    "participation_rate",
    "volatility_bucket",
    "spread_bucket",
    "time_bucket",
    "liquidity_bucket",
    "quote_quality_ref",
    "paper_or_live",
    "impact_claim_allowed",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "execution_cost_observation"},
    "observation_id": {"type": "string"},
    "intent_id": {"type": "string"},
    "order_id": {"type": "string"},
    "execution_id": {"type": "string"},
    "symbol": {"type": "string"},
    "side": {"type": "string", "enum": ["buy", "sell", "short", "cover"]},
    "order_type": {
      "type": "string",
      "enum": ["market", "limit", "stop", "stop_limit", "marketable_limit", "auction"]
    },
    "time_in_force": {
      "type": "string",
      "enum": ["day", "gtc", "ioc", "fok", "opg", "cls"]
    },
    "venue": {"type": "string"},
    "broker_route": {"type": "string"},
    "decision_at_utc": {"type": "string", "format": "utc-datetime"},
    "submit_at_utc": {"type": "string", "format": "utc-datetime"},
    "ack_at_utc": {"type": "string", "format": "utc-datetime"},
    "fill_at_utc": {"type": "string"},
    "arrival_timestamp_policy": {"type": "string"},
    "arrival_mid": {"type": "string"},
    "fill_price": {"type": "string"},
    "requested_qty": {"type": "string"},
    "filled_qty": {"type": "string"},
    "unfilled_qty": {"type": "string"},
    "partial_fill": {"type": "boolean"},
    "non_fill_reason": {"type": "string"},
    "signed_slippage_bps": {"type": "string"},
    "half_spread_bps": {"type": "string"},
    "queue_adverse_selection_bps": {"type": "string"},
    "halt_state": {
      "type": "string",
      "enum": ["none", "halted", "limit_up_limit_down", "circuit_breaker", "imbalance"]
    },
    "open_close_state": {
      "type": "string",
      "enum": ["open_auction", "close_auction", "regular_trading", "after_hours", "pre_open"]
    },
    "rate_limit_state": {
      "type": "string",
      "enum": ["nominal", "throttled", "rejected", "queued", "unknown"]
    },
    "notional": {"type": "string"},
    "interval_volume": {"type": "string"},
    "participation_rate": {"type": "string"},
    "volatility_bucket": {"type": "string"},
    "spread_bucket": {"type": "string"},
    "time_bucket": {"type": "string"},
    "liquidity_bucket": {"type": "string"},
    "quote_quality_ref": {"type": "string"},
    "paper_or_live": {
      "type": "string",
      "enum": ["paper", "live_probe", "live"]
    },
    "impact_claim_allowed": {"type": "boolean"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
