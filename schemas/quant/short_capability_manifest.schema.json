{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Short Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "manifest_id",
    "strategy_id",
    "broker_id",
    "broker_mode",
    "api_version",
    "short_research_simulation_supported",
    "short_runtime_supported",
    "order_marking_policy",
    "shortability_semantics",
    "paper_live_match_status",
    "allowed_symbols",
    "borrow_data_source",
    "shortability_data_source",
    "locate_documentation_required",
    "locate_expiry_policy",
    "freshness_threshold_seconds",
    "threshold_security_handling",
    "close_out_handling",
    "fee_policy",
    "recall_policy",
    "forced_buy_in_policy",
    "dividend_policy",
    "corporate_action_policy",
    "margin_policy",
    "exposure_caps",
    "live_probe_required",
    "approved_at_utc",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "short_capability_manifest"},
    "manifest_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "broker_id": {"type": "string"},
    "broker_mode": {
      "type": "string",
      "enum": ["paper", "live", "live_probe"]
    },
    "api_version": {"type": "string"},
    "short_research_simulation_supported": {"type": "boolean"},
    "short_runtime_supported": {"type": "boolean"},
    "order_marking_policy": {"type": "string"},
    "shortability_semantics": {"type": "string"},
    "paper_live_match_status": {
      "type": "string",
      "enum": ["matched", "mismatched", "unverified"]
    },
    "allowed_symbols": {"type": "array", "items": {"type": "string"}},
    "borrow_data_source": {"type": "string"},
    "shortability_data_source": {"type": "string"},
    "locate_documentation_required": {"type": "boolean"},
    "locate_expiry_policy": {"type": "string"},
    "freshness_threshold_seconds": {"type": "integer"},
    "threshold_security_handling": {"type": "string"},
    "close_out_handling": {"type": "string"},
    "fee_policy": {"type": "string"},
    "recall_policy": {"type": "string"},
    "forced_buy_in_policy": {"type": "string"},
    "dividend_policy": {"type": "string"},
    "corporate_action_policy": {"type": "string"},
    "margin_policy": {"type": "string"},
    "exposure_caps": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "live_probe_required": {"type": "boolean"},
    "approved_at_utc": {"type": "string", "format": "utc-datetime"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
