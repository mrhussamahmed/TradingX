{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Short Financing Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "model_id",
    "strategy_id",
    "version",
    "borrow_fee_curve",
    "locate_fee_policy",
    "dividend_liability_policy",
    "margin_model",
    "portfolio_margin_usage",
    "concentration_policy",
    "gross_policy",
    "net_policy",
    "stress_margin_bps",
    "cash_collateral_policy",
    "fee_stress_bps",
    "close_out_cost_policy",
    "recall_cost_policy",
    "forced_buy_in_slippage_bps",
    "financing_drag_bps",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "short_financing_model"},
    "model_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "version": {"type": "string"},
    "borrow_fee_curve": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "locate_fee_policy": {"type": "string"},
    "dividend_liability_policy": {"type": "string"},
    "margin_model": {"type": "string"},
    "portfolio_margin_usage": {"type": "string"},
    "concentration_policy": {"type": "string"},
    "gross_policy": {"type": "string"},
    "net_policy": {"type": "string"},
    "stress_margin_bps": {"type": "string", "format": "decimal-string"},
    "cash_collateral_policy": {"type": "string"},
    "fee_stress_bps": {"type": "string", "format": "decimal-string"},
    "close_out_cost_policy": {"type": "string"},
    "recall_cost_policy": {"type": "string"},
    "forced_buy_in_slippage_bps": {"type": "string", "format": "decimal-string"},
    "financing_drag_bps": {"type": "string", "format": "decimal-string"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
