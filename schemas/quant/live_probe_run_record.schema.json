{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Live Probe Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "plan_id",
    "strategy_id",
    "status",
    "order_count",
    "fill_count",
    "filled_notional",
    "session_count",
    "reconciliation_cycle_count",
    "slippage_summary_ref",
    "quote_quality_summary_ref",
    "limit_breach_count",
    "rollback_triggered",
    "success_criteria_met",
    "minimum_activity_met",
    "evidence_refs",
    "started_at_utc",
    "completed_at_utc",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "live_probe_run_record"},
    "run_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "inconclusive", "in_progress", "rolled_back"]
    },
    "order_count": {"type": "integer"},
    "fill_count": {"type": "integer"},
    "filled_notional": {"type": "string"},
    "session_count": {"type": "integer"},
    "reconciliation_cycle_count": {"type": "integer"},
    "slippage_summary_ref": {"type": "string"},
    "quote_quality_summary_ref": {"type": "string"},
    "limit_breach_count": {"type": "integer"},
    "rollback_triggered": {"type": "boolean"},
    "success_criteria_met": {"type": "boolean"},
    "minimum_activity_met": {"type": "boolean"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "started_at_utc": {"type": "string", "format": "utc-datetime"},
    "completed_at_utc": {"type": "string"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
