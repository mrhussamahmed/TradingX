{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Content Addressed Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string"},
    "strategy_id": {"type": "string"},
    "root_id": {"type": "string"},
    "worm_controls": {"type": "boolean"},
    "short_enabled": {"type": "boolean"},
    "contracts": {"type": "object"},
    "fixture": {"type": "string"},
    "description": {"type": "string"},
    "evidence_class": {"type": "string"},
    "artifact_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "artifact_kind": {"type": "string"},
    "mandate_id": {"type": "string"},
    "benchmark_id": {"type": "string"},
    "capital_role": {"type": "string"},
    "wealth_thesis": {"type": "string"},
    "utility_name": {"type": "string"},
    "allocation_policy_id": {"type": "string"},
    "tax_mode": {"type": "string"},
    "account_type": {"type": "string"},
    "financing_assumption": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "account_use": {"type": "string"},
    "regulatory_status": {"type": "string"},
    "instrument_type": {"type": "string"},
    "data_semantics": {"type": "string"},
    "execution_semantics": {"type": "string"},
    "margin_semantics": {"type": "string"},
    "settlement_semantics": {"type": "string"},
    "corporate_action_semantics": {"type": "string"},
    "tax_semantics": {"type": "string"},
    "risk_semantics": {"type": "string"},
    "lower_bound_spec_ref": {"type": "string"},
    "lower_bound_spec_hash": {"type": "string", "format": "sha256"},
    "pre_tax_or_after_tax": {"type": "string"},
    "taxable_or_tax_exempt_status": {"type": "string"},
    "estimator_family": {"type": "string"},
    "confidence_level": {"type": "string", "format": "decimal-string"},
    "return_horizon": {"type": "string"},
    "benchmark_pairing": {"type": "string"},
    "serial_dependence_correction": {"type": "string"},
    "fat_tail_treatment": {"type": "string"},
    "minimum_effective_sample_size": {"type": "integer"},
    "stress_inputs": {"type": "array", "items": {"type": "string"}},
    "lower_bound_net_edge": {"type": "string", "format": "decimal-string"},
    "pass_threshold": {"type": "string", "format": "decimal-string"}
  }
}
