{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Live Probe Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_id",
    "strategy_id",
    "broker_id",
    "broker_mode",
    "symbols",
    "capital_limit",
    "loss_limit",
    "order_count_limit",
    "participation_limit",
    "spread_limit_bps",
    "duration_seconds",
    "minimum_order_count",
    "minimum_filled_notional",
    "minimum_reconciliation_cycles",
    "minimum_sessions",
    "no_signal_outcome_policy",
    "start_criteria",
    "success_criteria",
    "rollback_criteria",
    "flatten_policy",
    "kill_switch_required",
    "pre_trade_control_manifest_ref",
    "authority_boundary_ref",
    "approved_at_utc",
    "expires_at_utc",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "live_probe_plan"},
    "plan_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "broker_id": {"type": "string"},
    "broker_mode": {
      "type": "string",
      "enum": ["paper", "live", "live_probe"]
    },
    "symbols": {"type": "array", "items": {"type": "string"}},
    "capital_limit": {"type": "string"},
    "loss_limit": {"type": "string"},
    "order_count_limit": {"type": "integer"},
    "participation_limit": {"type": "string"},
    "spread_limit_bps": {"type": "string"},
    "duration_seconds": {"type": "integer"},
    "minimum_order_count": {"type": "integer"},
    "minimum_filled_notional": {"type": "string"},
    "minimum_reconciliation_cycles": {"type": "integer"},
    "minimum_sessions": {"type": "integer"},
    "no_signal_outcome_policy": {
      "type": "string",
      "enum": ["inconclusive", "extension_allowed", "promotion_allowed"]
    },
    "start_criteria": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {"type": "array", "items": {"type": "string"}},
    "rollback_criteria": {"type": "array", "items": {"type": "string"}},
    "flatten_policy": {"type": "string"},
    "kill_switch_required": {"type": "boolean"},
    "pre_trade_control_manifest_ref": {"type": "string"},
    "authority_boundary_ref": {"type": "string"},
    "approved_at_utc": {"type": "string", "format": "utc-datetime"},
    "expires_at_utc": {"type": "string", "format": "utc-datetime"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
