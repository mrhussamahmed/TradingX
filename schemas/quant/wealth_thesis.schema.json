{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Wealth Thesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "mechanism",
    "persistence_reason",
    "beneficiary_regime",
    "benchmark_to_beat",
    "failure_condition",
    "edge_decay_detector",
    "capacity_limit",
    "kill_condition"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "wealth_thesis"},
    "strategy_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "mechanism": {"type": "string"},
    "persistence_reason": {"type": "string"},
    "beneficiary_regime": {"type": "string"},
    "benchmark_to_beat": {"type": "string"},
    "failure_condition": {"type": "string"},
    "edge_decay_detector": {"type": "string"},
    "capacity_limit": {"type": "string", "format": "decimal-string"},
    "kill_condition": {"type": "string"}
  }
}
