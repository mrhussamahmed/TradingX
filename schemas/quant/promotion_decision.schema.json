{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "strategy_id", "requested_state", "max_state", "target_weights", "blocker_codes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "promotion_decision"},
    "strategy_id": {"type": "string"},
    "requested_state": {
      "type": "string",
      "enum": [
        "disabled",
        "research_only",
        "paper_shadow",
        "paper_trading",
        "tiny_live_probe",
        "production"
      ]
    },
    "max_state": {
      "type": "string",
      "enum": [
        "disabled",
        "research_only",
        "paper_shadow",
        "paper_trading",
        "tiny_live_probe",
        "production"
      ]
    },
    "target_weights": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^-?\\d+(\\.\\d+)?$"}
    },
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
