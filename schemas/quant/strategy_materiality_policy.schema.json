{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Strategy Materiality Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "turnover_threshold",
    "volatility_threshold",
    "expected_edge_threshold",
    "minimum_sample_length",
    "decision_sensitivity_threshold",
    "allocation_sensitivity_threshold",
    "instrument_class",
    "safety_rule_sensitivity"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "strategy_materiality_policy"},
    "strategy_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "turnover_threshold": {"type": "string", "format": "decimal-string"},
    "volatility_threshold": {"type": "string", "format": "decimal-string"},
    "expected_edge_threshold": {"type": "string", "format": "decimal-string"},
    "minimum_sample_length": {"type": "integer"},
    "decision_sensitivity_threshold": {"type": "string", "format": "decimal-string"},
    "allocation_sensitivity_threshold": {"type": "string", "format": "decimal-string"},
    "instrument_class": {"type": "string"},
    "safety_rule_sensitivity": {"type": "string"}
  }
}
