{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Instrument Support Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy_id",
    "artifact_uri",
    "payload_hash",
    "ledger_sequence",
    "approval_record_refs",
    "authority_ref",
    "created_at_utc",
    "replay_input_refs",
    "instrument_class",
    "data_semantics",
    "corporate_action_treatment",
    "execution_venues",
    "order_types",
    "settlement_cycle",
    "margin_requirements",
    "short_borrow_semantics",
    "tax_treatment",
    "risk_model",
    "operational_controls",
    "broker_permissions",
    "promotion_ceiling"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "instrument_support_package"},
    "strategy_id": {"type": "string"},
    "artifact_uri": {"type": "string"},
    "payload_hash": {"type": "string", "format": "sha256"},
    "ledger_sequence": {"type": "integer"},
    "approval_record_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "authority_ref": {"type": "string"},
    "created_at_utc": {"type": "string", "format": "utc-datetime"},
    "replay_input_refs": {"type": "array", "items": {"type": "string", "format": "content-addressed-ref"}},
    "instrument_class": {"type": "string"},
    "data_semantics": {"type": "string"},
    "corporate_action_treatment": {"type": "string"},
    "execution_venues": {"type": "array", "items": {"type": "string"}},
    "order_types": {"type": "array", "items": {"type": "string"}},
    "settlement_cycle": {"type": "string"},
    "margin_requirements": {"type": "string"},
    "short_borrow_semantics": {"type": "string"},
    "tax_treatment": {"type": "string"},
    "risk_model": {"type": "string"},
    "operational_controls": {"type": "array", "items": {"type": "string"}},
    "broker_permissions": {"type": "array", "items": {"type": "string"}},
    "promotion_ceiling": {"type": "string"}
  }
}
