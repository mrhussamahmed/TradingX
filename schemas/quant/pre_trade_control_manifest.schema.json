{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradingX Pre-Trade Control Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "manifest_id",
    "strategy_id",
    "broker_id",
    "broker_mode",
    "price_collar_bps",
    "fat_finger_notional_limit",
    "fat_finger_share_limit",
    "max_open_orders",
    "max_order_rate_per_minute",
    "duplicate_prevention_enabled",
    "idempotency_key_policy",
    "cancel_on_disconnect",
    "self_trade_prevention",
    "buying_power_precheck",
    "margin_precheck",
    "locate_precheck_for_shorts",
    "reject_on_missing_control",
    "control_owner",
    "drill_refs",
    "approved_at_utc",
    "expires_at_utc",
    "blocker_codes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "kind": {"type": "string", "const": "pre_trade_control_manifest"},
    "manifest_id": {"type": "string"},
    "strategy_id": {"type": "string"},
    "broker_id": {"type": "string"},
    "broker_mode": {
      "type": "string",
      "enum": ["paper", "live", "live_probe"]
    },
    "price_collar_bps": {"type": "string"},
    "fat_finger_notional_limit": {"type": "string"},
    "fat_finger_share_limit": {"type": "string"},
    "max_open_orders": {"type": "integer"},
    "max_order_rate_per_minute": {"type": "integer"},
    "duplicate_prevention_enabled": {"type": "boolean"},
    "idempotency_key_policy": {"type": "string"},
    "cancel_on_disconnect": {"type": "boolean"},
    "self_trade_prevention": {
      "type": "string",
      "enum": ["enabled", "not_applicable", "disabled"]
    },
    "buying_power_precheck": {"type": "boolean"},
    "margin_precheck": {"type": "boolean"},
    "locate_precheck_for_shorts": {"type": "boolean"},
    "reject_on_missing_control": {"type": "boolean"},
    "control_owner": {"type": "string"},
    "drill_refs": {"type": "array", "items": {"type": "string"}},
    "approved_at_utc": {"type": "string", "format": "utc-datetime"},
    "expires_at_utc": {"type": "string", "format": "utc-datetime"},
    "blocker_codes": {"type": "array", "items": {"type": "string"}}
  }
}
